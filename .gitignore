# Third-party source material (game JARs, reference assets). Kept locally
# so we can re-extract textures/data without re-downloading, but never
# redistributed — their IP, not ours.
vendor/
Minecraft Alpha 1.2.6/

# GDExtension native build artifacts
bin/*.dylib
bin/*.so
bin/*.dll
bin/*.exp
bin/*.lib
bin/*.pdb
bin/*.wasm
godot-cpp/bin/
godot-cpp/gen/
*.o
*.obj
*.os
.sconsign.dblite
.sconf_temp/
config.log
assets/icon/app_icon.iconset/
.cate
.playwright-mcp
build
*.png
*.png.import
# ...except the game's own art, which has always been tracked (the blanket
# rule above was added later and never applied retroactively — over a
# thousand pack files are already in the index). Narrow allow-rules keep
# newly extracted or authored tiles consistent with their siblings instead
# of silently going missing on a fresh clone.
!assets/textures/packs/**/*.png
!assets/textures/packs/**/*.png.import
!assets/textures/items/*.png
!assets/textures/items/*.png.import
!assets/textures/mob/*.png
!assets/textures/mob/*.png.import
!assets/textures/entities/**/*.png
!assets/textures/entities/**/*.png.import
!assets/textures/gui/*.png
!assets/textures/gui/*.png.import
!assets/textures/particles/*.png
!assets/textures/particles/*.png.import
test-screenshots/
# `docs/*` rather than `docs/` so the negation below can take effect —
# git will not re-include a file whose parent DIRECTORY is excluded.
# Everything in docs/ stays ignored except the tracked feature plans,
# audit reports, and playtest guides selected below.
docs/*
!docs/redstone-*.md
!docs/nether-*.md
scripts/dev/internal
scripts/dev/__pycache__/
./Library
